					<a class="cm-crumbs__link" href="#lists">terminal multiplexer<span class="cm-crumbs__sep" aria-hidden="true">&rsaquo;</span></a>
					<span class="cm-crumbs__here" aria-current="page">cli-mono-embed</span>
				</nav>

				<h3 class="cm-kicker">the rules</h3>
				<div class="cm-spec">
					<div class="cm-spec__row" role="listitem">
						<span class="cm-spec__label"><code>cm-crumbs</code></span>
