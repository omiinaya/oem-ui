							<span class="cm-dropdown__icon" aria-hidden="true">&times;</span>
							<span class="cm-dropdown__label"><span class="cm-dropdown__label-text">delete file</span></span>
							<span class="cm-dropdown__shortcut" aria-hidden="true">shift del</span>
						</button>
					</div>
				</div>
