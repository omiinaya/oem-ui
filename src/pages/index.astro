			<section id="attachment" class="cm-section cm-section--pad">
				<SectionHead title="attachment">
					the file card: media, content, actions - plus a full-card
					trigger that paints above the content but below the actions, so
					activating the card never steals a click from <code>remove</code>.
					The upload lifecycle is styling, not layout: <code>uploading</code>
					and <code>processing</code> shimmer the title, <code>error</code> is
					the house double-rule with the reason kept in the description, and
					the group is a snapping row that composes
					<code>cm-scroll-fade</code> for its edge.
				</SectionHead>
				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label">states</span>
						<span class="cm-spec__val">idle / uploading / processing / error / done</span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label">sizes / shape</span>
						<span class="cm-spec__val">default / sm / xs, horizontal or vertical, image variant</span>
					</div>
				</div>
				<div style="display: grid; gap: var(--space-2);">
					<div class="cm-attach">
						<span class="cm-attach__media" aria-hidden="true">PDF</span>
						<span class="cm-attach__content">
							<span class="cm-attach__title">sales-dashboard.pdf</span>
							<span class="cm-attach__desc">PDF · 2.4 MB</span>
						</span>
						<span class="cm-attach__actions">
							<button class="cm-attach__action" type="button" aria-label="Remove sales-dashboard.pdf">×</button>
						</span>
					</div>
					<div class="cm-attach cm-attach--uploading">
						<span class="cm-attach__media" aria-hidden="true">CSV</span>
						<span class="cm-attach__content">
							<span class="cm-attach__title cm-shimmer">quarterly-export.csv</span>
							<span class="cm-attach__desc">uploading · 1.1 of 3.8 MB</span>
						</span>
						<span class="cm-attach__actions">
							<button class="cm-attach__action" type="button" aria-label="Cancel quarterly-export.csv upload">×</button>
						</span>
					</div>
					<div class="cm-attach cm-attach--processing">
						<span class="cm-attach__media" aria-hidden="true">MP4</span>
						<span class="cm-attach__content">
							<span class="cm-attach__title cm-shimmer">walkthrough.mp4</span>
							<span class="cm-attach__desc">processing · transcoding to 720p</span>
						</span>
					</div>
					<div class="cm-attach cm-attach--error">
						<span class="cm-attach__media" aria-hidden="true">ZIP</span>
						<span class="cm-attach__content">
							<span class="cm-attach__title">assets.zip</span>
							<span class="cm-attach__desc">failed - the upload exceeded the 25 MB limit; compress and retry</span>
						</span>
						<span class="cm-attach__actions">
							<button class="cm-attach__action" type="button" aria-label="Retry assets.zip upload">↻</button>
							<button class="cm-attach__action" type="button" aria-label="Remove assets.zip">×</button>
						</span>
					</div>
					<div class="cm-attach cm-attach--done">
						<span class="cm-attach__media" aria-hidden="true">OK</span>
						<span class="cm-attach__content">
							<span class="cm-attach__title">receipt-0842.pdf</span>
							<span class="cm-attach__desc">done · stored</span>
						</span>
					</div>
