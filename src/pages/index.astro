---
// Runtime and styles. The <script src> at the bottom of <body> is what
// bundles the runtime — a frontmatter `import` of a side-effect-only file
// gets tree-shaken away, so use the tag form.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
// The FOUC guard, inlined verbatim into <head> with ?raw. A <script src>
// would run after the stylesheets, which is the flash it prevents.
import themeGuard from '../js/cli-mono-theme-guard.js?raw';
import PageHead from '../astro/PageHead.astro';
import PostHead from '../astro/PostHead.astro';
import Header from '../astro/Header.astro';
import Footer from '../astro/Footer.astro';
import StatusStrip from '../astro/StatusStrip.astro';
import PostRow from '../astro/PostRow.astro';
import Stat from '../astro/Stat.astro';
import TimelineItem from '../astro/TimelineItem.astro';
import Card from '../astro/Card.astro';
import Meter from '../astro/Meter.astro';
import CodeBlock from '../astro/CodeBlock.astro';
import HeaderLink from '../astro/HeaderLink.astro';
import SectionHead from '../astro/SectionHead.astro';

/**
 * The showcase's section index, in DOCUMENT order.
 *
 * The rail is a scroll-spy, and a scroll-spy is only as good as the order
 * it is given. This was hand-written next to a hand-written list of nav
 * links, and the two drifted: the nav said `lists -> states -> ... ->
 * layout -> forms` while the DOM had `forms` sitting right after `lists`,
 * so scrolling lit up `forms` early and then jumped BACK UP to `states`.
 *
 * One array, read in both places. The contract test asserts that every
 * `id` in this list is a `<section>` in the markup AND that the order
 * matches the order they appear in the file, so a section added in the
 * wrong place fails the suite instead of quietly breaking the spy.
 */
const SECTION_ORDER = [
	'foundation', 'buttons', 'nav', 'crumbs', 'lists', 'states', 'surface',
  'selection', 'stack', 'density', 'badge', 'tblaction', 'table', 'data-table', 'json', 'rowon', 'switch', 'sheet', 'drawer', 'choice', 'keys-pages-people',
	'code', 'overlays', 'records', 'cards', 'tiles', 'prose', 'proselists', 'proselists-order', 'prosetap', 'prosetable', 'tablelabels', 'layout', 'surface-paint',
	'forms', 'datepicker', 'scrollarea', 'utilities', 'chat', 'dropdown-depth', 'navmenu', 'scroller', 'attachment', 'quiz', 'search', 'auth', 'readme',
] as const;

/* The log specimen. Long enough to actually scroll, because a sticky
   header on a table that fits is a sticky header nobody has tested - and
   `.cm-table-wrap` is capped with a max-height precisely so the wrapper
   becomes the vertical scrollport the header sticks to. Ten distinct
   rows, cycled to twelve so the source stays readable and the overflow
   is real rather than assumed. `k` is the tier, `g` the glyph: a log is
   read at a glance and often in greyscale, so the tier never rests on
   hue alone. */
const LOG_ROWS = [
	{ t: '2s ago',  m: 'GET',  host: 'plex.mrx.sh',      path: '/library/sections',                     k: 'ok',   g: '✓', s: '200', d: '12.4ms', ip: '10.0.0.9' },
	{ t: '4s ago',  m: 'GET',  host: 'plex.mrx.sh',      path: '/old/path',                             k: 'warn', g: '!', s: '301', d: '1.1ms',  ip: '10.0.0.9' },
	{ t: '9s ago',  m: 'POST', host: 'app.example.com',  path: '/api/upload',                           k: 'err',  g: '✕', s: '502', d: '30.0s',  ip: '10.0.0.4' },
	{ t: '14s ago', m: 'GET',  host: 'links.mrx.sh',     path: '/',                                     k: 'ok',   g: '✓', s: '200', d: '88.0ms', ip: '10.0.0.2' },
	{ t: '21s ago', m: 'GET',  host: 'cdn.mrx.sh',       path: '/assets/app.9f2c1a.js',                  k: 'ok',   g: '✓', s: '200', d: '4.2ms',  ip: '10.0.0.7' },
	{ t: '30s ago', m: 'HEAD', host: 'plex.mrx.sh',      path: '/library/sections/',                    k: 'warn', g: '!', s: '304', d: '0.9ms',  ip: '10.0.0.9' },
	{ t: '44s ago', m: 'GET',  host: 'gone.example.net', path: '/a/very/long/path/that/keeps/going/on', k: 'err',  g: '✕', s: '404', d: '2.0ms',  ip: '10.0.0.3' },
	{ t: '51s ago', m: 'GET',  host: 'links.mrx.sh',     path: '/tags/design-system',                   k: 'ok',   g: '✓', s: '200', d: '61.3ms', ip: '10.0.0.2' },
	{ t: '1m ago',  m: 'PUT',  host: 'api.mrx.sh',       path: '/v1/objects/9f2c1a',                    k: 'err',  g: '✕', s: '507', d: '12.0s',  ip: '10.0.0.5' },
	{ t: '1m ago',  m: 'GET',  host: 'plex.mrx.sh',      path: '/library/tokens',                       k: 'ok',   g: '✓', s: '200', d: '9.8ms',  ip: '10.0.0.9' },
] as const;
const LOG = Array.from({ length: 12 }, (_, i) => LOG_ROWS[i % LOG_ROWS.length]);

/* The data-table specimen: 23 rows so pagination has somewhere to GO
   (three pages of ten), four statuses so filtering has something to
   separate, sizes as bare numbers so the numeric sort path is the one
   exercised - a `4.2 MB` cell reads as text to the sort comparator, by
   design, and would not prove it. */
const DEPLOY_ROWS = [
	['live', 'oem-ui', 'omar', 412],
	['live', 'hermes-proxy', 'ci', 1180],
	['failed', 'spacetime-rpm', 'ci', 940],
	['queued', 'nodeterm', 'omar', 120],
	['live', 'dev-blog', 'ci', 268],
	['live', 'links', 'sullen', 96],
	['rolling', 'oem-cdn', 'ci', 2044],
	['failed', 'chappy', 'omar', 552],
	['live', 'browser-hub', 'ci', 733],
	['queued', 'code-spaces', 'sullen', 640],
	['live', 'spacetime-kanban', 'ci', 876],
	['live', 'hermes-articles', 'omar', 310],
	['failed', 'oem-portfolio', 'ci', 487],
	['live', 'spacetime-ab', 'ci', 1024],
	['queued', 'spacetime-memory', 'sullen', 655],
	['live', 'sullen.sh', 'omar', 148],
	['live', 'mrx-thunder', 'ci', 2310],
	['failed', 'oem-ngo-brand', 'omar', 77],
	['rolling', 'spacetime-llm', 'ci', 1602],
	['live', 'gantree', 'sullen', 205],
	['queued', 'hermes-hearth', 'ci', 993],
	['live', 'oem-ui-site', 'omar', 521],
	['live', 'fcm-relay', 'ci', 389],
] as const;

import { SITE } from '../astro/config';
---

<!doctype html>
<html lang="en">
	<head>
		<!-- The FOUC guard is the FIRST node in <head>, before the charset
		     declaration and before any stylesheet: a light-theme visitor must
		     never see a dark flash. Inlined from the shared library file, so
		     the showcase demonstrates the same guard a consumer installs
		     rather than a fourth hand-rolled copy that can drift. -->
		<script is:inline set:html={themeGuard} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>oem/ui — component library</title>
		<meta name="description" content="Zero-dependency mono design system: CSS, JS and Astro components." />
	</head>
	<body>
		<Header
			brand={SITE.title}
			homeHref="/"
			links={SECTION_ORDER.map((id) => ({ href: `#${id}`, label: id }))}
		extraLinks={[{ href: SITE.github, label: 'github' }]}
		rail
	/>
		<main class="cm-shell cm-shell--rail cm-stack cm-stack--section">
			<PageHead kicker="design system" title="oem/ui" sub="mono/terminal components. dark default. works anywhere." />
			<StatusStrip label="status" status="ok">
				css, js and astro components verified. build-testable.
			</StatusStrip>

			<!-- ==================================================== foundation
			     Every specimen below is rendered FROM the token it documents
			     (var(--ink), var(--space-4), and so on) rather than from a
			     hardcoded value pasted alongside. A specimen that disagreed
			     with its own token would be worse than no specimen, and a
			     test asserts the wiring. -->
			<section id="foundation" class="cm-section cm-section--pad">
				<SectionHead title="foundation">
The design language, shown as specimens. Every value here is rendered from the token it documents, so this page cannot drift away from the system it demos.
				</SectionHead>

				<h3>colour</h3>
				<p class="cm-head__sub">
					Greyscale only. There is no chroma anywhere in the system,
					so hierarchy is carried by weight, size and contrast - never
					by hue. <code>--ink-faint</code> is the one to watch: it is
					the dimmest text we allow, and it still clears WCAG AA.
				</p>
				<ul class="cm-swatch" role="list">
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--bg)"></span>
						<span class="cm-swatch__meta"><code>--bg</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--panel)"></span>
						<span class="cm-swatch__meta"><code>--panel</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--line)"></span>
						<span class="cm-swatch__meta"><code>--line</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--ink)"></span>
						<span class="cm-swatch__meta"><code>--ink</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--ink-dim)"></span>
						<span class="cm-swatch__meta"><code>--ink-dim</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--ink-faint)"></span>
						<span class="cm-swatch__meta"><code>--ink-faint</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--accent-bright)"></span>
						<span class="cm-swatch__meta"><code>--accent-bright</code></span>
					</li>
				</ul>

				<h3>type</h3>
				<p class="cm-head__sub">
					One family, everywhere: that is the identity. Sizes are set in
					<code>rem</code> against a 16px root; the floor is
					<code>--min-font</code>, below which we never render text.
				</p>
				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>h1</code></span>
						<span class="cm-spec__sample" style="font-size:2.1rem">Aa</span>
						<span class="cm-spec__val"><code>2.1rem · 33.6px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>h2</code></span>
						<span class="cm-spec__sample" style="font-size:1.45rem">Aa</span>
						<span class="cm-spec__val"><code>1.45rem · 23.2px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>h3</code></span>
						<span class="cm-spec__sample" style="font-size:1.2rem">Aa</span>
						<span class="cm-spec__val"><code>1.2rem · 19.2px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>body</code></span>
						<span class="cm-spec__sample" style="font-size:1rem">Aa</span>
						<span class="cm-spec__val"><code>1rem · 16px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>small</code></span>
						<span class="cm-spec__sample" style="font-size:max(var(--min-font), 0.82rem)">Aa</span>
						<span class="cm-spec__val"><code>--min-font floor · 13.1px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>floor</code></span>
						<span class="cm-spec__sample" style="font-size:var(--min-font)">Aa</span>
						<span class="cm-spec__val"><code>--min-font · 12px, the minimum</code></span>
					</div>
				</div>

				<h3>spacing</h3>
				<p class="cm-head__sub">
					Eleven steps, and no raw <code>rem</code> anywhere in the
					layers. A gap that is not on this scale is the bug that made
					oem-links' hero weld its eyebrow to its title.
				</p>
				<div class="cm-spec">
					{[
						['--space-0', '0.125rem', '2px'],
						['--space-1', '0.25rem', '4px'],
						['--space-2', '0.5rem', '8px'],
						['--space-3', '0.75rem', '12px'],
						['--space-4', '1rem', '16px'],
						['--space-5', '1.25rem', '20px'],
						['--space-6', '1.5rem', '24px'],
						['--space-7', '2rem', '32px'],
						['--space-8', '3rem', '48px'],
						['--space-9', '4rem', '64px'],
						['--space-10', '6rem', '96px'],
					].map(([token, rem, px]) => (
						<div class="cm-spec__row">
							<span class="cm-spec__label"><code>{token}</code></span>
							<span class="cm-spec__bar" style={`width:var(${token})`}></span>
							<span class="cm-spec__val"><code>{rem} · {px}</code></span>
						</div>
					))}
				</div>

				<h3>shape &amp; motion</h3>
				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--radius</code></span>
						<span class="cm-spec__chip" style="border-radius:var(--radius)"></span>
						<span class="cm-spec__val"><code>0px · sharp</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--radius-sm</code></span>
						<span class="cm-spec__chip" style="border-radius:var(--radius-sm)"></span>
						<span class="cm-spec__val"><code>0px · sharp</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--tap</code></span>
						<span class="cm-spec__chip cm-spec__chip--tap"></span>
						<span class="cm-spec__val"><code>44px · the tap target floor</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--cm-t</code></span>
						<span class="cm-spec__chip cm-spec__chip--motion"></span>
						<span class="cm-spec__val"><code>0.12s · every transition</code></span>
					</div>
				</div>

				<h3>layers</h3>
				<dl class="cm-kv">
					<dt>tokens</dt><dd><code>src/styles/tokens.css</code> (CSS vars, themes)</dd>
					<dt>base</dt><dd><code>src/styles/base.css</code> (elements, prose, scrollbar)</dd>
					<dt>components</dt><dd><code>src/styles/components.css</code> (classes .cm-*)</dd>
					<dt>runtime</dt><dd><code>src/js/cli-mono.js</code> (theme, header, spy, copy)</dd>
				</dl>
			</section>

			<section id="buttons" class="cm-section cm-section--pad">
				<SectionHead title="buttons" />
				<div class="cm-btn-group">
					<a class="cm-btn">Default</a>
					<a class="cm-btn cm-btn--primary">Primary</a>
					<a class="cm-btn cm-btn--ghost">Ghost</a>
					<a class="cm-btn cm-btn--outline">Outline</a>
					<a class="cm-btn cm-btn--sm">Small</a>
					<a class="cm-btn cm-btn--block">Block</a>
				</div>
				<div class="cm-btn-group" style="margin-top:var(--space-4)">
					<button class="cm-btn cm-btn--danger">Delete</button>
					<span class="cm-btn-group cm-btn-group--joined" role="group" aria-label="View">
						<button class="cm-btn">Day</button>
						<button class="cm-btn">Week</button>
						<button class="cm-btn">Month</button>
					</span>
				</div>
				<p class="cm-head__sub"><code>cm-btn--outline</code> is shadcn’s invert-on-hover button: the border is the body. <code>cm-btn--danger</code> is a cross plus a heavier rule, never a hue. <code>cm-btn-group--joined</code> collapses neighbouring borders into one control.</p>
			</section>

			<!-- ==================================================== nav
			     The two nav states are different questions and the showcase
			     has to show both, because conflating them is the bug: `active`
			     says WHERE YOU ARE (this page), the scroll-spy's `is-active`
			     says WHAT YOU ARE READING as you scroll. The first nav is
			     live - it is the one in the header, so its states are real,
			     not a hand-built mock. -->
			<section id="nav" class="cm-section cm-section--pad">
				<SectionHead title="nav">
Two states, two different questions. <code>active</code> marks the page you are on and renders <code>aria-current="page"</code>; the scroll-spy marks what you are reading as you scroll. They coexist on a one-page site, so they cannot be the same attribute. Scroll to watch the first nav above change.
				</SectionHead>

				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>active</code></span>
						<span class="cm-spec__sample" style="display:flex;gap:var(--space-1)">
							<a href="#nav" class="cm-header__link" aria-current="page">notes</a>
							<a href="#nav" class="cm-header__link">about</a>
						</span>
						<span class="cm-spec__val"><code>aria-current="page"</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>spy</code></span>
						<span class="cm-spec__sample" style="display:flex;gap:var(--space-1)">
							<a href="#nav" class="cm-header__link is-active">notes</a>
							<a href="#nav" class="cm-header__link">about</a>
						</span>
						<span class="cm-spec__val"><code>is-active · runtime</code></span>
					</div>
				</div>

				<h3 class="cm-kicker cm-kicker--plain">grouped rail</h3>
				<p class="cm-head__sub">
					An application rail has labelled groups. The label is its own element,
					not a link: a heading wearing a link's class inherits the 44px tap floor
					and becomes a dead target for a screen reader.
				</p>
				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>nested list</code></span>
						<span class="cm-spec__sample" style="display:block;width:15rem;position:relative;overflow:hidden">
												<!-- The specimen must be a REAL rail. The geometry is declared
												     under `.cm-header--rail`, so a fixture that merely
												     *nests* the shape renders the old 14px inline links and
												     demonstrates nothing: measured at 1280x900, the first
												     version of this row measured min-height `auto`,
												     display `block` and height 14.3px while the paragraph
												     beside it claimed the rail geometry was visible.
												     `.cm-header--rail` is `position: fixed` at desktop, so
												     the rail-specific fixed positioning is neutralised
												     here and the class is kept - the SELECTOR is the
												     thing being demonstrated, not the position. -->
												<div class="cm-header cm-header--rail" data-cm-grouped-rail-fixture
												     style="position:static;width:100%;border-right:0;inset:auto">
													<div class="cm-header__nav">
														<div class="cm-header__links">
															<div class="cm-header__group">
																<span class="cm-header__group-label">hosting</span>
																<div class="cm-header__links">
																	<a href="#nav" class="cm-header__link" aria-current="page">proxy hosts</a>
																	<a href="#nav" class="cm-header__link">streams</a>
																	<a href="#nav" class="cm-header__link">databases</a>
																</div>
															</div>
															<div class="cm-header__group">
																<span class="cm-header__group-label">delivery</span>
																<div class="cm-header__links">
																	<a href="#nav" class="cm-header__link">webhooks</a>
																	<a href="#nav" class="cm-header__link">logs</a>
																</div>
															</div>
														</div>
													</div>
												</div>
											</span>
						<span class="cm-spec__val"><code>the shape rpm ships</code></span>
					</div>
				</div>

				<p class="cm-head__sub" style="margin-top:var(--space-3)">
					A group's list is a <code>.cm-header__links</code> of its own, so its links sit
					one level deeper than a flat rail's &mdash; which is why the rail row rule
					carries a second selector for the group. It used to be
					<code>&gt; .cm-header__link</code> alone, and a grouped rail matched
					nothing: no tap floor and no current marker, measured in WebKit at
					1280&times;900 at 34&nbsp;px rows with <code>border-left-width: 0</code>.
				</p>
				<p class="cm-head__sub" style="margin-top:var(--space-2)">
					The specimen above is that nest inside a real <code>.cm-header--rail</code>
					&mdash; nesting alone is not enough, because every rail rule is keyed on that
					class &mdash; with two labelled groups and five rows, so the marker is visibly
					one row and not five. The rail is a <code>min-width: 1000px</code> layout, so
					read it on a desktop window; below that the rail collapses into the header's
					disclosure, and the rows are measured there instead.
				</p>

				<h3 class="cm-kicker">mobile disclosure</h3>
				<p class="cm-head__sub">
					Twelve links do not fit a phone, so under 640px the nav collapses
					behind a burger &mdash; the one in the header above. Narrow this
					window to see it. The collapse is scoped to the runtime having booted,
					so a reader without JavaScript still gets every link inline.
				</p>
				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>closed</code></span>
						<span class="cm-spec__sample" style="display:flex;align-items:center;gap:var(--space-3)">
							<button
								class="cm-icon-btn cm-nav-toggle cm-nav-toggle--demo"
								type="button"
								aria-hidden="true"
								tabindex="-1"
							>
								<span class="cm-nav-toggle__bars" aria-hidden="true">
									<span class="cm-nav-toggle__bar"></span>
								</span>
							</button>
							<span class="cm-head__sub">the real control is in the header above</span>
						</span>
						<span class="cm-spec__val"><code>aria-expanded</code></span>
					</div>
				</div>
				<p class="cm-head__sub" style="margin-top:var(--space-3)">
					Tapping a link closes the panel, so the menu never sits on top of the
					section you just asked for. <code>Escape</code> closes it and returns
					focus to the button, and rotating to a desktop width clears the state
					rather than leaking it into the next phone view.
				</p>

				<h3 class="cm-kicker">bare glyph on a header surface</h3>
				<p class="cm-head__sub">
					<em>boxed</em> is the default: a button that needs to read as a
					control on its own, sitting on a surface with no other chrome.
					<em>bare</em> drops the border and the radius for a glyph that shares
					a surface with other glyphs &mdash; a header row where an outlined
					button next to an unoutlined icon reads as a mistake, not a
					control. Both are the same component; only the framing differs.
				</p>
				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>boxed</code></span>
						<span class="cm-spec__sample" style="display:flex;align-items:center;gap:var(--space-3)">
							<button
								class="cm-icon-btn"
								type="button"
								aria-hidden="true"
								tabindex="-1"
							>&#9673;</button>
							<span class="cm-head__sub">its own outline says &ldquo;press me&rdquo;</span>
						</span>
						<span class="cm-spec__val"><code>cm-icon-btn</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>bare</code></span>
						<span class="cm-spec__sample" style="display:flex;align-items:center;gap:var(--space-3)">
							<button
								class="cm-icon-btn cm-icon-btn--bare"
								type="button"
								data-cm-theme-toggle
								aria-label="Toggle theme"
								title="Toggle theme"
							>
								<span data-cm-theme-icon aria-hidden="true">&#9728;</span>
							</button>
							<span class="cm-head__sub">the live control, same target either way</span>
						</span>
						<span class="cm-spec__val"><code>cm-icon-btn--bare</code></span>
					</div>
				</div>
				<p class="cm-head__sub" style="margin-top:var(--space-3)">
					Both stay square on a phone. The bare form is what
					<a href="https://links.oem.ngo/">oem-links</a> and
					<a href="https://log.oem.ngo/">oem-log</a> each hand-rolled; the
					tap floor applies to both, and a bare glyph with only half its box
					from the floor measures 44&times;32 &mdash; tall enough to pass a
					height check, still too narrow to hit.
				</p>

				<h3 class="cm-kicker">HeaderLink</h3>
				<p class="cm-head__sub">
					Path matching is the part of a nav every consumer gets wrong, so the library
					owns it. The first link points at this page, so it marks itself current; the
					others do not. Note the trailing slashes and the query string, which it
					ignores.
				</p>
				<!-- `cm-spec` wrappers, NOT .cm-header__link. The demo links use the real
				     class so the current state is visible, which means the live scroll-spy
				     can also see them: a bare .cm-header__link with href="#nav" was lit
				     is-active by the header's own spy, so a demo of one state lit the
				     other. Scoping them here keeps the specimen honest. -->
				<div class="cm-spec" role="list">
					<div class="cm-spec__row" role="listitem">
						<span class="cm-spec__label"><code>here</code></span>
						<span class="cm-spec__sample"><HeaderLink href="#nav">#nav</HeaderLink></span>
						<span class="cm-spec__val"><code>aria-current="page"</code></span>
					</div>
					<div class="cm-spec__row" role="listitem">
						<span class="cm-spec__label"><code>other</code></span>
						<span class="cm-spec__sample"><HeaderLink href="/somewhere-else/">/other/</HeaderLink></span>
						<span class="cm-spec__val"><code>no attribute</code></span>
					</div>
					<div class="cm-spec__row" role="listitem">
						<span class="cm-spec__label"><code>external</code></span>
						<span class="cm-spec__sample"><HeaderLink href="https://example.com/">https://…</HeaderLink></span>
						<span class="cm-spec__val"><code>never current</code></span>
					</div>
				</div>
				</section>

			<section id="crumbs" class="cm-section cm-section--pad">
				<SectionHead title="breadcrumb">
					The trail above a detail page: how deep am I, and how do I get out. It is the first thing a thumb touches, so every crumb is a <code>--tap</code> target; the separator is a <code>.cm-crumbs__sep</code> carrying <code>aria-hidden="true"</code> so a screen reader never speaks it; and the last crumb is marked <code>aria-current="page"</code>, the same attribute the header nav uses, so "you are here" survives greyscale print and a screen reader.
				</SectionHead>

				<h3 class="cm-kicker cm-kicker--flush">three levels</h3>
				<nav class="cm-crumbs" aria-label="Breadcrumb">
					<a class="cm-crumbs__link" href="#lists">plugins<span class="cm-crumbs__sep" aria-hidden="true">&rsaquo;</span></a>
					<a class="cm-crumbs__link" href="#lists">terminal<span class="cm-crumbs__sep" aria-hidden="true">&rsaquo;</span></a>
					<span class="cm-crumbs__here" aria-current="page">cli-mono</span>
				</nav>

				<h3 class="cm-kicker">deep trail, wraps on a phone</h3>
				<p class="cm-head__sub">
					A trail grows with its depth. Five levels at 390px overflows the
					column, so this one wraps. Each separator lives <em>inside</em> the
					crumb it follows, so a wrap can never strand a lone chevron on a
					line of its own. The last crumb is <code>aria-current="page"</code>
					and is not a link — so it carries no separator <em>after</em> it,
					but it keeps the one before, which is the trail reading left to
					right.
				</p>
				<nav class="cm-crumbs" aria-label="Breadcrumb, deep">
					<a class="cm-crumbs__link" href="#lists">store<span class="cm-crumbs__sep" aria-hidden="true">&rsaquo;</span></a>
