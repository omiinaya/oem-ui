		<Footer
			items={['astro', 'static', 'zero deps']}
			contactHref="mailto:omar@mrx.sh"
			/* Three fragments, not two, on purpose. The invariant under test
			   is "no wrapped line ENDS with a separator", and a two-fragment
			   status fits on one line at every width down to 320 - so the
			   case that matters never occurs and the suite is measuring a row
			   that cannot fail. A fixture that does not WRAP proves nothing;
			   this one does at 320x667. Measured, not assumed. */
			status={['all systems nominal', 'sig: static only', 'no trackers, no cookies']}
		/>

	<!-- Runtime. Use a real script tag: a frontmatter import of a
	     side-effect-only file gets tree-shaken out of the bundle. -->
	<!-- Imported, not a raw <script src>: a relative src on a .astro page is
     NOT treated as a build asset, so Astro emitted the tag verbatim and no
     JS ever shipped. Importing it hands the file to Vite, which bundles it
     and rewrites the src to a hashed asset. -->
<script>
	import '../js/cli-mono.js';

	// Showcase glue only: the library exposes cliMono.toast(nodeOrString),
	// and these three buttons exist to prove it. A consumer builds the
	// node and hands it over, exactly as the README shows.
	const TOASTS = {
		ok: ['saved', 'The layers are byte-identical to the source.'],
		warn: ['vendored copy is stale', 'Run the sync check before trusting its CSS.'],
		err: ['build failed', 'Two spacing bars measured the wrong length.'],
	};

	document.querySelectorAll('[data-cm-toast-demo]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const [title, text] = TOASTS[btn.dataset.cmToastDemo] || [];
			const el = document.createElement('div');
			el.className = `cm-toast cm-toast--${btn.dataset.cmToastDemo}`;
			el.setAttribute('data-cm-toast', '');
			// No role="alert" here. The region is already role="status"
			// aria-live="polite" and announces the insertion; an alert
			// nested in a live region announces it a second time.
			el.innerHTML =
				'<span class="cm-toast__mark" aria-hidden="true"></span>' +
				'<div class="cm-toast__body">' +
				`<p class="cm-toast__title">${title}</p>` +
				`<p class="cm-toast__text">${text}</p>` +
				'</div>' +
				'<button type="button" class="cm-toast__close" data-cm-toast-close aria-label="Dismiss">×</button>';
			document.querySelector('[data-cm-toasts]').appendChild(el);
			window.cliMono.toast(el);
		});
	});

	// The four RUNTIME demos: these call the library's own API, because
	// info / loading / action / promise exist only there - the static
	// builder above is showcase scaffolding, not the shipped path.
	// cliMono is read AT CLICK TIME: this classic script runs before the
	// deferred module, so capturing it here would capture undefined.
	document.querySelectorAll('[data-cm-toast-kind]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const kind = btn.dataset.cmToastKind;
			const cli = window.cliMono;
			if (kind === 'info') cli.toast('3 hosts re-synced', 'info');
			else if (kind === 'loading') cli.toast('compiling the fleet\u2026', 'loading', { duration: 4000 });
			else if (kind === 'action') {
				cli.toast('row deleted', 'info', {
					action: { label: 'undo', onClick: () => cli.toast('restored', 'ok') },
				});
			} else if (kind === 'promise') {
				btn.dataset.cmRuns = String((Number(btn.dataset.cmRuns) || 0) + 1);
				const pass = Number(btn.dataset.cmRuns) % 2 === 1;
				cli.toast.promise(
					new Promise((res, rej) =>
						setTimeout(() => (pass ? res() : rej(new Error('refused'))), 1600)
					),
					{ loading: 'syncing the fleet\u2026', success: 'fleet in sync', error: 'sync refused' }
				);
			}
		});
	});

	// The SPEC action specimen answers the same `cm:action` event the
	// runtime dispatches - the wiring a consumer would write. Scoped to
	// .cm-spec so the runtime demo's own callback (which already shows
	// its toast) is not answered twice.
	document.addEventListener('cm:action', (e) => {
		const node = e.target;
		if (node && node.closest && node.closest('.cm-spec') && window.cliMono) {
			window.cliMono.toast('restored', 'ok');
		}
	});
</script>
	</body>
