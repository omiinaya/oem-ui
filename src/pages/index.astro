							<tr><td>base</td><td>base.css</td><td class="cm-table__num">412</td><td class="cm-table__num">7</td></tr>
							<tr><td>components</td><td>components.css</td><td class="cm-table__num">1180</td><td class="cm-table__num">31</td></tr>
							<tr><td>runtime</td><td>cli-mono.js</td><td class="cm-table__num">196</td><td class="cm-table__num">3</td></tr>
						</tbody>
					</table>
				</div>
