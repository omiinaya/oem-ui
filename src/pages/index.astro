---
// Runtime and styles. The <script src> at the bottom of <body> is what
// bundles the runtime — a frontmatter `import` of a side-effect-only file
// gets tree-shaken away, so use the tag form.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import PageHead from '../astro/PageHead.astro';
import PostHead from '../astro/PostHead.astro';
import Header from '../astro/Header.astro';
import Footer from '../astro/Footer.astro';
import StatusStrip from '../astro/StatusStrip.astro';
import PostRow from '../astro/PostRow.astro';
import Stat from '../astro/Stat.astro';
import TimelineItem from '../astro/TimelineItem.astro';
import Card from '../astro/Card.astro';
import Meter from '../astro/Meter.astro';
import HeaderLink from '../astro/HeaderLink.astro';
import { SITE } from '../astro/config';
---

<!doctype html>
<html lang="en">
	<head>
		<!-- The FOUC guard is the FIRST node in <head>, before the charset
		     declaration and before any stylesheet: a light-theme visitor must
		     never see a dark flash. -->
		<script is:inline>
			(function () {
				try {
					var s = localStorage.getItem('cm-theme');
					if (s === 'light') document.documentElement.setAttribute('data-theme', 'light');
				} catch (e) {}
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>oem-ui — component library</title>
		<meta name="description" content="Zero-dependency mono design system: CSS, JS and Astro components." />
	</head>
	<body>
		<Header
			brand={SITE.title}
			homeHref="/"
			links={[
				{ href: '#foundation', label: 'foundation' },
				{ href: '#buttons', label: 'buttons' },
				{ href: '#nav', label: 'nav' },
				{ href: '#lists', label: 'lists' },
				{ href: '#states', label: 'states' },
				{ href: '#overlays', label: 'overlays' },
				{ href: '#records', label: 'records' },
				{ href: '#cards', label: 'cards' },
				{ href: '#prose', label: 'prose' },
				{ href: '#layout', label: 'layout' },
				{ href: '#forms', label: 'forms' },
				{ href: '#readme', label: 'readme' },
			]}
		/>
		<main>
			<PageHead kicker="design system" title="oem-ui" sub="mono/terminal components. dark default. works anywhere." />
			<StatusStrip label="status" status="ok">
				css, js and astro components verified. build-testable.
			</StatusStrip>

			<!-- ==================================================== foundation
			     Every specimen below is rendered FROM the token it documents
			     (var(--ink), var(--space-4), and so on) rather than from a
			     hardcoded value pasted alongside. A specimen that disagreed
			     with its own token would be worse than no specimen, and a
			     test asserts the wiring. -->
			<section id="foundation" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>foundation</h2>
				<p class="cm-head__sub">
					The design language, shown as specimens. Every value here is
					rendered from the token it documents, so this page cannot
					drift away from the system it demos.
				</p>

				<h3>colour</h3>
				<p class="cm-head__sub">
					Greyscale only. There is no chroma anywhere in the system,
					so hierarchy is carried by weight, size and contrast - never
					by hue. <code>--ink-faint</code> is the one to watch: it is
					the dimmest text we allow, and it still clears WCAG AA.
				</p>
				<ul class="cm-swatch" role="list">
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--bg)"></span>
						<span class="cm-swatch__meta"><code>--bg</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--panel)"></span>
						<span class="cm-swatch__meta"><code>--panel</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--line)"></span>
						<span class="cm-swatch__meta"><code>--line</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--ink)"></span>
						<span class="cm-swatch__meta"><code>--ink</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--ink-dim)"></span>
						<span class="cm-swatch__meta"><code>--ink-dim</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--ink-faint)"></span>
						<span class="cm-swatch__meta"><code>--ink-faint</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--accent-bright)"></span>
						<span class="cm-swatch__meta"><code>--accent-bright</code></span>
					</li>
				</ul>

				<h3>type</h3>
				<p class="cm-head__sub">
					One family, everywhere: that is the identity. Sizes are set in
					<code>rem</code> against a 16px root; the floor is
					<code>--min-font</code>, below which we never render text.
				</p>
				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>h1</code></span>
						<span class="cm-spec__sample" style="font-size:2.1rem">Aa</span>
						<span class="cm-spec__val"><code>2.1rem · 33.6px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>h2</code></span>
						<span class="cm-spec__sample" style="font-size:1.45rem">Aa</span>
						<span class="cm-spec__val"><code>1.45rem · 23.2px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>h3</code></span>
						<span class="cm-spec__sample" style="font-size:1.2rem">Aa</span>
						<span class="cm-spec__val"><code>1.2rem · 19.2px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>body</code></span>
						<span class="cm-spec__sample" style="font-size:1rem">Aa</span>
						<span class="cm-spec__val"><code>1rem · 16px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>small</code></span>
						<span class="cm-spec__sample" style="font-size:max(var(--min-font), 0.82rem)">Aa</span>
						<span class="cm-spec__val"><code>--min-font floor · 13.1px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>floor</code></span>
						<span class="cm-spec__sample" style="font-size:var(--min-font)">Aa</span>
						<span class="cm-spec__val"><code>--min-font · 12px, the minimum</code></span>
					</div>
				</div>

				<h3>spacing</h3>
				<p class="cm-head__sub">
					Eleven steps, and no raw <code>rem</code> anywhere in the
					layers. A gap that is not on this scale is the bug that made
					oem-links' hero weld its eyebrow to its title.
				</p>
				<div class="cm-spec">
					{[
						['--space-0', '0.125rem', '2px'],
						['--space-1', '0.25rem', '4px'],
						['--space-2', '0.5rem', '8px'],
						['--space-3', '0.75rem', '12px'],
						['--space-4', '1rem', '16px'],
						['--space-5', '1.25rem', '20px'],
						['--space-6', '1.5rem', '24px'],
						['--space-7', '2rem', '32px'],
						['--space-8', '3rem', '48px'],
						['--space-9', '4rem', '64px'],
						['--space-10', '6rem', '96px'],
					].map(([token, rem, px]) => (
						<div class="cm-spec__row">
							<span class="cm-spec__label"><code>{token}</code></span>
							<span class="cm-spec__bar" style={`width:var(${token})`}></span>
							<span class="cm-spec__val"><code>{rem} · {px}</code></span>
						</div>
					))}
				</div>

				<h3>shape &amp; motion</h3>
				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--radius</code></span>
						<span class="cm-spec__chip" style="border-radius:var(--radius)"></span>
						<span class="cm-spec__val"><code>10px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--radius-sm</code></span>
						<span class="cm-spec__chip" style="border-radius:var(--radius-sm)"></span>
						<span class="cm-spec__val"><code>6px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--tap</code></span>
						<span class="cm-spec__chip cm-spec__chip--tap"></span>
						<span class="cm-spec__val"><code>44px · the tap target floor</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--cm-t</code></span>
						<span class="cm-spec__chip cm-spec__chip--motion"></span>
						<span class="cm-spec__val"><code>0.12s · every transition</code></span>
					</div>
				</div>

				<h3>layers</h3>
				<dl class="cm-kv">
					<dt>tokens</dt><dd><code>src/styles/tokens.css</code> (CSS vars, themes)</dd>
					<dt>base</dt><dd><code>src/styles/base.css</code> (elements, prose, scrollbar)</dd>
					<dt>components</dt><dd><code>src/styles/components.css</code> (classes .cm-*)</dd>
					<dt>runtime</dt><dd><code>src/js/cli-mono.js</code> (theme, header, spy, copy)</dd>
				</dl>
			</section>

			<section id="buttons" class="cm-section cm-section--pad" style="margin-bottom:1.8rem">
				<h2>buttons</h2>
				<div class="cm-btn-group">
					<a class="cm-btn">Default</a>
					<a class="cm-btn cm-btn--primary">Primary</a>
					<a class="cm-btn cm-btn--ghost">Ghost</a>
					<a class="cm-btn cm-btn--sm">Small</a>
					<a class="cm-btn cm-btn--block">Block</a>
				</div>
			</section>

			<!-- ==================================================== nav
			     The two nav states are different questions and the showcase
			     has to show both, because conflating them is the bug: `active`
			     says WHERE YOU ARE (this page), the scroll-spy's `is-active`
			     says WHAT YOU ARE READING as you scroll. The first nav is
			     live - it is the one in the header, so its states are real,
			     not a hand-built mock. -->
			<section id="nav" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>nav</h2>
				<p class="cm-head__sub">
					Two states, two different questions. <code>active</code> marks the page you
					are on and renders <code>aria-current="page"</code>; the scroll-spy marks
					what you are reading as you scroll. They coexist on a one-page site, so
					they cannot be the same attribute. Scroll to watch the first nav above
					change.
				</p>

				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>active</code></span>
						<span class="cm-spec__sample" style="display:flex;gap:var(--space-1)">
							<a href="#nav" class="cm-header__link" aria-current="page">notes</a>
							<a href="#nav" class="cm-header__link">about</a>
						</span>
						<span class="cm-spec__val"><code>aria-current="page"</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>spy</code></span>
						<span class="cm-spec__sample" style="display:flex;gap:var(--space-1)">
							<a href="#nav" class="cm-header__link is-active">notes</a>
							<a href="#nav" class="cm-header__link">about</a>
						</span>
						<span class="cm-spec__val"><code>is-active · runtime</code></span>
					</div>
				</div>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">HeaderLink</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					Path matching is the part of a nav every consumer gets wrong, so the library
					owns it. The first link points at this page, so it marks itself current; the
					others do not. Note the trailing slashes and the query string, which it
					ignores.
				</p>
				<!-- `cm-spec` wrappers, NOT .cm-header__link. The demo links use the real
				     class so the current state is visible, which means the live scroll-spy
				     can also see them: a bare .cm-header__link with href="#nav" was lit
				     is-active by the header's own spy, so a demo of one state lit the
				     other. Scoping them here keeps the specimen honest. -->
				<div class="cm-spec" role="list">
					<div class="cm-spec__row" role="listitem">
						<span class="cm-spec__label"><code>here</code></span>
						<span class="cm-spec__sample"><HeaderLink href="#nav">#nav</HeaderLink></span>
						<span class="cm-spec__val"><code>aria-current="page"</code></span>
					</div>
					<div class="cm-spec__row" role="listitem">
						<span class="cm-spec__label"><code>other</code></span>
						<span class="cm-spec__sample"><HeaderLink href="/somewhere-else/">/other/</HeaderLink></span>
						<span class="cm-spec__val"><code>no attribute</code></span>
					</div>
					<div class="cm-spec__row" role="listitem">
						<span class="cm-spec__label"><code>external</code></span>
						<span class="cm-spec__sample"><HeaderLink href="https://example.com/">https://…</HeaderLink></span>
						<span class="cm-spec__val"><code>never current</code></span>
					</div>
				</div>
				</section>

			<section id="lists" class="cm-section cm-section--pad" style="margin-bottom:1.8rem">
				<h2>lists / rows</h2>
				<div class="cm-list-head" style="margin-bottom:0.4rem">Index / compact</div>
				<ul class="cm-rows cm-rows--inline">
					<PostRow href="#1" index={3} title="Extract components from a design" description="separate tokens, base, components and runtime." date={new Date('2025-09-26')} />
					<PostRow href="#2" index={2} title="Make them portable" description="zero deps, plain classes, works in any framework." date={new Date('2025-09-25')} />
					<PostRow href="#3" index={1} title="Ship as a library" description="dark default, FOUC-safe theme toggle." date={new Date('2025-09-24')} />
				</ul>
				<div class="cm-list-more"><a href="#">$ cat all →</a></div>
			</section>

			<section id="forms" class="cm-section cm-section--pad" style="margin-bottom:1.8rem">
				<h2>forms</h2>
				<p class="cm-head__sub">
					inputs are element defaults, so a bare <code>&lt;input&gt;</code> is already
					on-brand. <code>.cm-field</code> and friends are the layout around them.
				</p>
				<form class="cm-form" onsubmit="return false">
					<div class="cm-field-row">
						<div class="cm-field">
							<label class="cm-field__label" for="f-name">handle <span class="cm-field__req">*</span></label>
							<input id="f-name" type="text" placeholder="omiinaya" required />
							<span class="cm-field__help">lowercase, no spaces.</span>
						</div>
						<div class="cm-field">
							<label class="cm-field__label" for="f-kind">kind</label>
							<select id="f-kind">
								<option>site</option>
								<option>repo</option>
								<option>service</option>
							</select>
						</div>
					</div>

					<div class="cm-field">
						<label class="cm-field__label" for="f-url">url <span class="cm-field__req">*</span></label>
						<input id="f-url" type="url" placeholder="https://" aria-invalid="true" />
						<span class="cm-field__error">must include the scheme.</span>
					</div>

					<div class="cm-field">
						<label class="cm-field__label" for="f-notes">notes</label>
						<textarea id="f-notes" rows="3" placeholder="what is it for?"></textarea>
					</div>

					<fieldset class="cm-field">
						<legend>visibility</legend>
						<label><input type="checkbox" checked /> listed in nav</label>
						<label><input type="checkbox" /> pinned</label>
					</fieldset>

					<fieldset class="cm-field">
						<legend>access</legend>
						<label><input type="radio" name="f-access" checked /> public</label>
						<label><input type="radio" name="f-access" /> unlisted</label>
					</fieldset>

					<div class="cm-form__actions">
						<button type="reset" class="cm-btn">cancel</button>
						<button type="submit" class="cm-btn cm-btn--primary">save</button>
					</div>
				</form>
			</section>

			<!-- ==================================================== states
			     Every async surface has to render these three, and a system
			     that does not own them lets every consumer invent them —
			     usually in colour, or as an unguarded spinner. -->
			<section id="states" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>states</h2>
				<p class="cm-head__sub">
					What a surface shows before it has data, and after it fails. Status is
					carried by a glyph and a word, never by hue: this system has no chroma to
					carry it, and greyscale print still reads correctly.
				</p>

				<h3 class="cm-kicker">empty</h3>
				<div class="cm-state">
					<span class="cm-state__mark" aria-hidden="true">Ø</span>
					<p class="cm-state__title">Nothing here yet</p>
					<p class="cm-state__body">
						An empty surface still needs a shape. A blank div reads as a broken
						page; this one says the same thing on purpose.
					</p>
					<div class="cm-state__actions">
						<a class="cm-btn cm-btn--sm" href="#states">create the first one</a>
					</div>
				</div>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">loading</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					Two different jobs. A <strong>skeleton</strong> is for a surface whose
					shape you already know; a <strong>spinner</strong> is for an action in
					flight. Both stop under <code>prefers-reduced-motion</code>.
				</p>
				<div class="cm-skeleton" aria-hidden="true" style="max-width:22rem">
					<div class="cm-skeleton__block"></div>
					<div class="cm-skeleton__line"></div>
					<div class="cm-skeleton__line cm-skeleton__line--w60"></div>
					<div class="cm-skeleton__line cm-skeleton__line--w40"></div>
				</div>
				<p class="cm-spinner-row" role="status" style="margin-top:var(--space-4)">
					<span class="cm-spinner" aria-hidden="true"></span>
					working…
				</p>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">alerts</h3>
				<div style="display:grid;gap:var(--space-3);max-width:34rem">
					<div class="cm-alert cm-alert--ok" role="status">
						<span class="cm-alert__mark" aria-hidden="true"></span>
						<div class="cm-alert__body">
							<p class="cm-alert__title">saved</p>
							<p class="cm-alert__text">The runtime is bundled and the toggle persists under this site's own key.</p>
						</div>
					</div>
					<div class="cm-alert cm-alert--warn" role="status">
						<span class="cm-alert__mark" aria-hidden="true"></span>
						<div class="cm-alert__body">
							<p class="cm-alert__title">vendored copy is stale</p>
							<p class="cm-alert__text">A consumer still holds an old copy of the layers. Run the sync check before trusting its CSS.</p>
						</div>
					</div>
					<div class="cm-alert cm-alert--err" role="alert">
						<span class="cm-alert__mark" aria-hidden="true"></span>
						<div class="cm-alert__body">
							<p class="cm-alert__title">build failed</p>
							<p class="cm-alert__text">Two of eleven spacing bars measured the wrong length. A specimen that lies is worse than no specimen.</p>
						</div>
					</div>
				</div>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">table</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					Data, not prose. The scroll wrapper is part of the component: a wide table
					that overflows the page is the most common way a mono layout breaks on a
					phone, so the component refuses to let it.
				</p>
				<div class="cm-table-wrap" tabindex="0" role="region" aria-label="token cost by layer">
					<table class="cm-table">
						<thead>
							<tr><th>layer</th><th>file</th><th class="num">lines</th><th class="num">touches</th></tr>
						</thead>
						<tbody>
							<tr aria-selected="true"><td>tokens</td><td>tokens.css</td><td class="num">231</td><td class="num">4</td></tr>
							<tr><td>base</td><td>base.css</td><td class="num">412</td><td class="num">7</td></tr>
							<tr><td>components</td><td>components.css</td><td class="num">1180</td><td class="num">31</td></tr>
							<tr><td>runtime</td><td>cli-mono.js</td><td class="num">196</td><td class="num">3</td></tr>
						</tbody>
					</table>
				</div>
			</section>

			<!-- ==================================================== overlays
			     Five components that sit ON TOP of the page, and three of
			     them are the platform's element: <dialog>, [popover] and
			     hover/focus. Nothing here has a runtime that reimplements
			     what a browser already does correctly. -->
			<section id="overlays" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>overlays</h2>
				<p class="cm-head__sub">
					Five surfaces that sit on top of the page. Four of the five are
					native elements doing native things &mdash; a <code>&lt;dialog&gt;</code>,
					a <code>[popover]</code>, a hover, a <code>hidden</code> attribute. Only
					the tablist needs script, because the platform ships no tab widget
					and the roving tabindex is the one part of the ARIA contract CSS
					cannot express.
				</p>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">tabs</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					Tab with the keyboard to leave the row, then use the arrows: one tab
					is in the tab order at a time, which is the WAI-ARIA pattern. The
					active tab is an <em>inset</em> rule rather than a thicker border,
					because 2px of border would widen every box and walk the row sideways.
				</p>
				<div class="cm-tabs">
					<div class="cm-tabs__list" role="tablist" aria-label="layer ownership">
						<button
							type="button"
							class="cm-tabs__tab"
							role="tab"
							id="tab-tokens"
							aria-selected="true"
							aria-controls="panel-tokens"
						>tokens</button>
						<button
							type="button"
							class="cm-tabs__tab"
							role="tab"
							id="tab-base"
							aria-selected="false"
							aria-controls="panel-base"
						>base</button>
						<button
							type="button"
							class="cm-tabs__tab"
							role="tab"
							id="tab-components"
							aria-selected="false"
							aria-controls="panel-components"
						>components</button>
					</div>
					<div class="cm-tabs__panel" role="tabpanel" id="panel-tokens" aria-labelledby="tab-tokens" tabindex="0">
						Every value, both themes. A hardcoded hex in the layer below is a
						rebrand bug, so this file is the contract.
					</div>
					<div class="cm-tabs__panel" role="tabpanel" id="panel-base" aria-labelledby="tab-base" tabindex="0" hidden>
						Element defaults, prose rhythm, scrollbar, a11y helpers. A bare
						<code>&lt;input&gt;</code> is on-brand because it lives here, not
						behind a class.
					</div>
					<div class="cm-tabs__panel" role="tabpanel" id="panel-components" aria-labelledby="tab-components" tabindex="0" hidden>
						The <code>.cm-*</code> classes: the arrangement <em>around</em> an
						element, which is the part that is actually a design decision.
					</div>
				</div>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">dialog</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					A native <code>&lt;dialog&gt;</code> opened with
					<code>showModal()</code>, so focus trapping, Escape, the top layer and
					the inertness of the page behind it are the browser's job, not ours.
					<code>::backdrop</code> paints <code>--scrim</code>, which is a token and
					differs per theme &mdash; the same alpha over near-black and near-white
					does not hide the page by the same amount.
				</p>
				<div class="cm-btn-group">
					<button type="button" class="cm-btn" data-cm-open="dlg-demo">open dialog</button>
				</div>
				<dialog class="cm-dialog" id="dlg-demo" aria-labelledby="dlg-demo-title">
					<form method="dialog" class="cm-dialog__head">
						<h3 class="cm-dialog__title" id="dlg-demo-title">Close the build?</h3>
						<button type="submit" class="cm-toast__close" aria-label="Close" value="close">&times;</button>
					</form>
					<div class="cm-dialog__body">
						<p>
							This is the native element. Tab is trapped here, Escape closes, and
							the page behind it is inert without a single line of script.
						</p>
						<p>
							The scrim is <code>--scrim</code>, and the two themes set it to
							different values for exactly that reason.
						</p>
					</div>
					<div class="cm-dialog__foot">
						<button type="submit" class="cm-btn" value="cancel">cancel</button>
						<button type="submit" class="cm-btn cm-btn--primary" value="confirm">close it</button>
					</div>
				</dialog>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">toast</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					A transient <code>.cm-alert</code>: the same border weights, the same
					glyphs, the same words. A second, prettier alert component is how one
					system quietly becomes two. Each retires itself after six seconds, or
					immediately via its close control.
				</p>
				<div class="cm-btn-group">
					<button type="button" class="cm-btn" data-cm-toast-demo="ok">toast ok</button>
					<button type="button" class="cm-btn" data-cm-toast-demo="warn">toast warn</button>
					<button type="button" class="cm-btn" data-cm-toast-demo="err">toast err</button>
				</div>
				<div class="cm-toast-region" data-cm-toasts role="status" aria-live="polite"></div>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">dropdown</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					The native Popover API. The trigger carries
					<code>popovertarget</code> and the panel carries <code>popover</code>,
					so light-dismiss, Escape and focus return are the browser's &mdash;
					and there is no runtime code for this component at all.
				</p>
				<div class="cm-dropdown">
					<button type="button" class="cm-btn" popovertarget="menu-demo" aria-haspopup="menu">
						actions <span aria-hidden="true">&#9662;</span>
					</button>
					<div class="cm-dropdown__menu" id="menu-demo" popover role="menu" aria-label="row actions">
						<button type="button" class="cm-dropdown__item" role="menuitem">rename</button>
						<button type="button" class="cm-dropdown__item" role="menuitem">duplicate</button>
						<hr class="cm-dropdown__sep" />
						<button type="button" class="cm-dropdown__item" role="menuitem" aria-disabled="true">delete</button>
					</div>
				</div>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">tooltip</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					A real element rather than generated content, because
					<code>aria-describedby</code> has to resolve to something in the
					accessibility tree and a <code>::after</code> is not there. The trigger
					is focusable, so <code>:focus-within</code> reveals the tip from the
					keyboard with no JS. Hidden tips are
					<code>visibility: hidden</code>, not merely transparent: a
					transparent tip is still announced and still swallows a click.
				</p>
				<p class="cm-btn-group">
					<span class="cm-tooltip cm-tooltip--start">
						<button type="button" class="cm-btn" aria-describedby="tip-demo">
							--start
						</button>
						<span class="cm-tooltip__tip" id="tip-demo" role="tooltip">
							Pinned to the trigger's leading edge.
						</span>
					</span>
					<span class="cm-tooltip">
						<button type="button" class="cm-btn" aria-describedby="tip-demo-centre">
							centred
						</button>
						<span class="cm-tooltip__tip" id="tip-demo-centre" role="tooltip">
							Centred: the tip may be wider than the button.
						</span>
					</span>
					<span class="cm-tooltip cm-tooltip--end">
						<button type="button" class="cm-btn" aria-describedby="tip-demo-end">
							--end
						</button>
						<span class="cm-tooltip__tip" id="tip-demo-end" role="tooltip">
							Pinned to the trailing edge.
						</span>
					</span>
					<span class="cm-tooltip cm-tooltip--below cm-tooltip--start">
						<button type="button" class="cm-btn" aria-describedby="tip-demo-below">
							--below
						</button>
						<span class="cm-tooltip__tip" id="tip-demo-below" role="tooltip">
							Below, when there is no room above.
						</span>
					</span>
				</p>
				<p class="cm-head__sub">
					A tip is capped at the viewport, and the page root clips
					horizontal overflow, so an overlay that is wider than its
					trigger can never make the page scroll sideways. Prefer
					<code>--start</code> or <code>--end</code> near an edge: a
					centred tip is only fully visible when the trigger sits
					clear of both margins.
				</p>
			</section>

			<!-- ==================================================== records
			     A metric tile is not a key/value row and a work history
			     is not a link list, so both needed a real component. -->
			<section id="records" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>Records</h2>
				<p class="cm-head__sub" style="margin-bottom:var(--space-5)">
					Stat tiles and a dated timeline. The tile count is data, so
					<code>.cm-stats</code> sizes its columns with
					<code>auto-fit</code> rather than a fixed number, and the timeline
					rail is drawn on the <em>item</em> so it stops at the last
					record on its own, with no script.
				</p>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-bottom:var(--space-3)">stat tiles</h3>
				<ul class="cm-stats">
					<Stat value="8+" label="years in IT" note="since 2014" />
					<Stat value="5,000+" label="users and devices" note="global estate" />
					<Stat value="3" label="CompTIA certs" note="A+, Tech+, ITF+" />
				</ul>
				<p class="cm-head__sub" style="margin-top:var(--space-3)">
					The note line is optional. It is the qualifier that makes a
					number honest: “5,000+” on its own is a boast, “5,000+ across
					the estate” is a fact.
				</p>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6);margin-bottom:var(--space-3)">timeline</h3>
				<ul class="cm-timeline">
					<TimelineItem
						period="2014 – 2017"
						role="Help Desk Technical Support"
						org="Union University"
						meta="Jackson, TN"
						body={'Phone-based support for university services. Setup of campus computers, printers and peripherals.'}
					/>
					<TimelineItem
						period="Feb 2022 – present"
						role="L2 Tech Analyst"
						org="Richemont"
						meta="Coral Gables, FL"
						body={'Owns HQ office IT for a global luxury group: device lifecycle, access management and compliance reporting.'}
						now
					/>
				</ul>
			</section>

			<!-- ==================================================== cards
			     One subject that needs more room than a row, and a
			     number that is a proportion rather than a count. -->
			<section id="cards" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>Cards and meters</h2>
				<p class="cm-head__sub" style="margin-bottom:var(--space-5)">
					A card is a unit of content with a title, so
					<code>.cm-cards</code> is a grid and <code>.cm-card</code>
					fills its cell — a two-line card and a six-line card in
					the same row still share a bottom edge. A meter is a
					number that happens to be drawn: the bar is
					<code>aria-hidden</code> and the value is real text, so
					the chart and the sentence can never disagree.
				</p>

				<ul class="cm-cards">
					<Card title="A+ 220-1101" sub="taken 2022 · lapsed 2025" accent>
						<p class="cm-card__text">
							Hardware and networking for a working technician. The
							domains below are the published exam weighting, not a
							score: this is what the exam actually asked.
						</p>
						<div class="cm-meters">
							<Meter label="Mobile devices" value="13%" pct={13} />
							<Meter label="Networking" value="23%" pct={23} variant="accent" />
							<Meter label="Hardware" value="25%" pct={25} />
							<Meter label="Virtualization and cloud" value="11%" pct={11} variant="faint" />
							<Meter label="Troubleshooting" value="28%" pct={28} />
						</div>
						<Fragment slot="foot">
							<a class="cm-card__link" href="https://example.com/a-plus">exam objectives →</a>
						</Fragment>
					</Card>

					<Card title="A short one" sub="cards are not all the same height">
						<p class="cm-card__text">
							The short card is the test. If it stretched to match
							the tall one, <code>align-items: start</code> and
							<code>height: 100%</code> are wrong.
						</p>
					</Card>
				</ul>
				<p class="cm-head__sub" style="margin-top:var(--space-3)">
					<code>--accent</code> marks the one card a reader should look
					at first. It is a 2px rule, not a hue: the palette has none
					to spend, and a border cannot drift from the tokens in
					light or dark.
				</p>
			</section>

			<!-- ==================================================== prose
			     An article head, then the prose it introduces. The
			     <PostHead> import here is load-bearing: nothing else
			     in the showcase rendered it, so `astro build` never
			     compiled the component and a class it emits could
			     sit undefined in the stylesheet indefinitely. A
			     contract test now checks markup against selectors,
			     but demonstrating the component is what proves the
			     rule renders the way it reads. -->
			<section id="prose" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>prose</h2>
				<p class="cm-head__sub" style="margin-bottom:var(--space-5)">
					<code>.cm-prose</code> for the body of an article and
					<code>.cm-post-head</code> for the block above it. The
					post head is the one page head that carries a rule
					under itself, because the thing below it is prose and
					not another section.
				</p>

				<article>
					<PostHead
						title="Extract components from a design"
						date={new Date('2025-09-26')}
						updatedDate={new Date('2025-09-27')}
					/>
					<div class="cm-prose">
						<h2>A heading</h2>
						<p>oem-ui is the design language: sharp, flat, mono, high-contrast, dark by default. Transitions are <code>0.12s</code>, corners stay square, and borders do the lifting.</p>
						<blockquote>Only touch a line if you can explain why it moved. The layout must be stable between scrolling and non-scrolling pages.</blockquote>
						<pre><code>{`:root { --maxw: 860px; --gutter: 1.25rem; }`}</code></pre>
					</div>
				</article>
			</section>
			<!-- ==================================================== layout
			     The two page shapes that are not a single column: a lede
			     under the head, and a main block with a metadata aside.
			     Both were hand-rolled per consumer with a raw `ch` in
			     each file, so a change to reading measure never reached
			     any of them. The specimens below are drawn FROM the
			     tokens they document. -->
			<section id="layout" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>layout</h2>
				<p class="cm-head__sub" style="margin-bottom:var(--space-5)">
					<code>.cm-lede</code> is the opening sentence under a page
					head, and <code>.cm-split</code> puts a metadata column beside
					a content block. The measure comes from
					<code>--measure</code>, not a number typed next to it, so
					changing the reading width is a token change. The split
					stacks below 700px on purpose: two columns of text on a
					phone is two unreadable columns.
				</p>

				<div class="cm-spec" style="margin-bottom:var(--space-6)">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--measure</code></span>
						<span class="cm-spec__sample"><span class="cm-lede" style="margin:0">The widest a reading column gets, in characters.</span></span>
						<span class="cm-spec__val"><code>68ch</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--measure-narrow</code></span>
						<span class="cm-spec__sample"><span class="cm-lede" style="margin:0;max-width:var(--measure-narrow)">A compact block, not re-wrapped.</span></span>
						<span class="cm-spec__val"><code>34ch</code></span>
					</div>
				</div>

				<h3 class="cm-kicker cm-kicker--plain">lede</h3>
				<p class="cm-lede">
					Read this before the rest. It is wider and dimmer than the
					body text, so the eye takes the sentence in once and then
					moves down to the content instead of reading the page twice.
				</p>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">split</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-4)">
					The main block and the aside below are the same DOM at every
					width; only the column count changes. Narrow the window past
					700px and the aside drops under the content rather than
					squeezing beside it.
				</p>
				<div class="cm-split">
					<div>
						<p style="margin-top:0">
							The main column keeps the reading measure and takes the
							wider share of the two. Nothing about it changes shape
							across the breakpoint, so the paragraph you read on a
							phone is the paragraph you read on a desktop.
						</p>
						<p>
							A second paragraph, so the column is taller than a single
							block of text and the gap between the columns is doing
							visible work.
						</p>
					</div>
					<aside class="cm-split__aside">
						<dl class="cm-kv">
							<dt>role</dt><dd>engineer</dd>
							<dt>since</dt><dd>2014</dd>
							<dt>based</dt><dd>remote</dd>
						</dl>
						<a class="cm-back" href="#layout">
							<span class="cm-back__arrow" aria-hidden="true">&#8592;</span>
							<span>back to layout</span>
						</a>
					</aside>
				</div>
			</section>

			<section id="readme" class="cm-section cm-section--pad">
				<h2>usage</h2>
				<div class="cm-term">
					<div class="cm-term__bar">
						<span class="cm-term__dot"></span><span class="cm-term__dot"></span><span class="cm-term__dot"></span>
						<span class="cm-term__title">README</span>
					</div>
					<div class="cm-term__body">
						<pre># oem-ui
npm i -D oem-ui@workspace or copy src/ into your project.
Include tokens.css, base.css, components.css and cli-mono.js.
Astro: import Header/Footer/Head/PageHead/PostHead from 'oem-ui/astro'.</pre>
					</div>
				</div>
			</section>
		</main>
		<Footer
			items={['astro', 'static', 'zero deps']}
			contactHref="mailto:omar@mrxlab.net"
			status="all systems nominal — sig: static only"
		/>

	<!-- Runtime. Use a real script tag: a frontmatter import of a
	     side-effect-only file gets tree-shaken out of the bundle. -->
	<!-- Imported, not a raw <script src>: a relative src on a .astro page is
     NOT treated as a build asset, so Astro emitted the tag verbatim and no
     JS ever shipped. Importing it hands the file to Vite, which bundles it
     and rewrites the src to a hashed asset. -->
<script>
	import '../js/cli-mono.js';

	// Showcase glue only: the library exposes cliMono.toast(nodeOrString),
	// and these three buttons exist to prove it. A consumer builds the
	// node and hands it over, exactly as the README shows.
	const TOASTS = {
		ok: ['saved', 'The layers are byte-identical to the source.'],
		warn: ['vendored copy is stale', 'Run the sync check before trusting its CSS.'],
		err: ['build failed', 'Two spacing bars measured the wrong length.'],
	};

	document.querySelectorAll('[data-cm-toast-demo]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const [title, text] = TOASTS[btn.dataset.cmToastDemo] || [];
			const el = document.createElement('div');
			el.className = `cm-toast cm-toast--${btn.dataset.cmToastDemo}`;
			el.setAttribute('data-cm-toast', '');
			// No role="alert" here. The region is already role="status"
			// aria-live="polite" and announces the insertion; an alert
			// nested in a live region announces it a second time.
			el.innerHTML =
				'<span class="cm-toast__mark" aria-hidden="true"></span>' +
				'<div class="cm-toast__body">' +
				`<p class="cm-toast__title">${title}</p>` +
				`<p class="cm-toast__text">${text}</p>` +
				'</div>' +
				'<button type="button" class="cm-toast__close" data-cm-toast-close aria-label="Dismiss">×</button>';
			document.querySelector('[data-cm-toasts]').appendChild(el);
			window.cliMono.toast(el);
		});
	});
</script>
	</body>
	</html>
