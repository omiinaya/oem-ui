---
// Runtime and styles. The <script src> at the bottom of <body> is what
// bundles the runtime — a frontmatter `import` of a side-effect-only file
// gets tree-shaken away, so use the tag form.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import PageHead from '../astro/PageHead.astro';
import Header from '../astro/Header.astro';
import Footer from '../astro/Footer.astro';
import StatusStrip from '../astro/StatusStrip.astro';
import PostRow from '../astro/PostRow.astro';
import HeaderLink from '../astro/HeaderLink.astro';
import { SITE } from '../astro/config';
---

<!doctype html>
<html lang="en">
	<head>
		<!-- The FOUC guard is the FIRST node in <head>, before the charset
		     declaration and before any stylesheet: a light-theme visitor must
		     never see a dark flash. -->
		<script is:inline>
			(function () {
				try {
					var s = localStorage.getItem('cm-theme');
					if (s === 'light') document.documentElement.setAttribute('data-theme', 'light');
				} catch (e) {}
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>oem-ui — component library</title>
		<meta name="description" content="Zero-dependency mono design system: CSS, JS and Astro components." />
	</head>
	<body>
		<Header
			brand={SITE.title}
			homeHref="/"
			links={[
				{ href: '#foundation', label: 'foundation' },
				{ href: '#buttons', label: 'buttons' },
				{ href: '#nav', label: 'nav' },
				{ href: '#lists', label: 'lists' },
				{ href: '#states', label: 'states' },
				{ href: '#prose', label: 'prose' },
				{ href: '#forms', label: 'forms' },
				{ href: '#readme', label: 'readme' },
			]}
		/>
		<main>
			<PageHead kicker="design system" title="oem-ui" sub="mono/terminal components. dark default. works anywhere." />
			<StatusStrip label="status" status="ok">
				css, js and astro components verified. build-testable.
			</StatusStrip>

			<!-- ==================================================== foundation
			     Every specimen below is rendered FROM the token it documents
			     (var(--ink), var(--space-4), and so on) rather than from a
			     hardcoded value pasted alongside. A specimen that disagreed
			     with its own token would be worse than no specimen, and a
			     test asserts the wiring. -->
			<section id="foundation" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>foundation</h2>
				<p class="cm-head__sub">
					The design language, shown as specimens. Every value here is
					rendered from the token it documents, so this page cannot
					drift away from the system it demos.
				</p>

				<h3>colour</h3>
				<p class="cm-head__sub">
					Greyscale only. There is no chroma anywhere in the system,
					so hierarchy is carried by weight, size and contrast - never
					by hue. <code>--ink-faint</code> is the one to watch: it is
					the dimmest text we allow, and it still clears WCAG AA.
				</p>
				<ul class="cm-swatch" role="list">
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--bg)"></span>
						<span class="cm-swatch__meta"><code>--bg</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--panel)"></span>
						<span class="cm-swatch__meta"><code>--panel</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--line)"></span>
						<span class="cm-swatch__meta"><code>--line</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--ink)"></span>
						<span class="cm-swatch__meta"><code>--ink</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--ink-dim)"></span>
						<span class="cm-swatch__meta"><code>--ink-dim</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--ink-faint)"></span>
						<span class="cm-swatch__meta"><code>--ink-faint</code></span>
					</li>
					<li class="cm-swatch__item">
						<span class="cm-swatch__chip" style="background:var(--accent-bright)"></span>
						<span class="cm-swatch__meta"><code>--accent-bright</code></span>
					</li>
				</ul>

				<h3>type</h3>
				<p class="cm-head__sub">
					One family, everywhere: that is the identity. Sizes are set in
					<code>rem</code> against a 16px root; the floor is
					<code>--min-font</code>, below which we never render text.
				</p>
				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>h1</code></span>
						<span class="cm-spec__sample" style="font-size:2.1rem">Aa</span>
						<span class="cm-spec__val"><code>2.1rem · 33.6px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>h2</code></span>
						<span class="cm-spec__sample" style="font-size:1.45rem">Aa</span>
						<span class="cm-spec__val"><code>1.45rem · 23.2px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>h3</code></span>
						<span class="cm-spec__sample" style="font-size:1.2rem">Aa</span>
						<span class="cm-spec__val"><code>1.2rem · 19.2px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>body</code></span>
						<span class="cm-spec__sample" style="font-size:1rem">Aa</span>
						<span class="cm-spec__val"><code>1rem · 16px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>small</code></span>
						<span class="cm-spec__sample" style="font-size:max(var(--min-font), 0.82rem)">Aa</span>
						<span class="cm-spec__val"><code>--min-font floor · 13.1px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>floor</code></span>
						<span class="cm-spec__sample" style="font-size:var(--min-font)">Aa</span>
						<span class="cm-spec__val"><code>--min-font · 12px, the minimum</code></span>
					</div>
				</div>

				<h3>spacing</h3>
				<p class="cm-head__sub">
					Eleven steps, and no raw <code>rem</code> anywhere in the
					layers. A gap that is not on this scale is the bug that made
					oem-links' hero weld its eyebrow to its title.
				</p>
				<div class="cm-spec">
					{[
						['--space-0', '0.125rem', '2px'],
						['--space-1', '0.25rem', '4px'],
						['--space-2', '0.5rem', '8px'],
						['--space-3', '0.75rem', '12px'],
						['--space-4', '1rem', '16px'],
						['--space-5', '1.25rem', '20px'],
						['--space-6', '1.5rem', '24px'],
						['--space-7', '2rem', '32px'],
						['--space-8', '3rem', '48px'],
						['--space-9', '4rem', '64px'],
						['--space-10', '6rem', '96px'],
					].map(([token, rem, px]) => (
						<div class="cm-spec__row">
							<span class="cm-spec__label"><code>{token}</code></span>
							<span class="cm-spec__bar" style={`width:var(${token})`}></span>
							<span class="cm-spec__val"><code>{rem} · {px}</code></span>
						</div>
					))}
				</div>

				<h3>shape &amp; motion</h3>
				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--radius</code></span>
						<span class="cm-spec__chip" style="border-radius:var(--radius)"></span>
						<span class="cm-spec__val"><code>10px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--radius-sm</code></span>
						<span class="cm-spec__chip" style="border-radius:var(--radius-sm)"></span>
						<span class="cm-spec__val"><code>6px</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--tap</code></span>
						<span class="cm-spec__chip cm-spec__chip--tap"></span>
						<span class="cm-spec__val"><code>44px · the tap target floor</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>--cm-t</code></span>
						<span class="cm-spec__chip cm-spec__chip--motion"></span>
						<span class="cm-spec__val"><code>0.12s · every transition</code></span>
					</div>
				</div>

				<h3>layers</h3>
				<dl class="cm-kv">
					<dt>tokens</dt><dd><code>src/styles/tokens.css</code> (CSS vars, themes)</dd>
					<dt>base</dt><dd><code>src/styles/base.css</code> (elements, prose, scrollbar)</dd>
					<dt>components</dt><dd><code>src/styles/components.css</code> (classes .cm-*)</dd>
					<dt>runtime</dt><dd><code>src/js/cli-mono.js</code> (theme, header, spy, copy)</dd>
				</dl>
			</section>

			<section id="buttons" class="cm-section cm-section--pad" style="margin-bottom:1.8rem">
				<h2>buttons</h2>
				<div class="cm-btn-group">
					<a class="cm-btn">Default</a>
					<a class="cm-btn cm-btn--primary">Primary</a>
					<a class="cm-btn cm-btn--ghost">Ghost</a>
					<a class="cm-btn cm-btn--sm">Small</a>
					<a class="cm-btn cm-btn--block">Block</a>
				</div>
			</section>

			<!-- ==================================================== nav
			     The two nav states are different questions and the showcase
			     has to show both, because conflating them is the bug: `active`
			     says WHERE YOU ARE (this page), the scroll-spy's `is-active`
			     says WHAT YOU ARE READING as you scroll. The first nav is
			     live - it is the one in the header, so its states are real,
			     not a hand-built mock. -->
			<section id="nav" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>nav</h2>
				<p class="cm-head__sub">
					Two states, two different questions. <code>active</code> marks the page you
					are on and renders <code>aria-current="page"</code>; the scroll-spy marks
					what you are reading as you scroll. They coexist on a one-page site, so
					they cannot be the same attribute. Scroll to watch the first nav above
					change.
				</p>

				<div class="cm-spec">
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>active</code></span>
						<span class="cm-spec__sample" style="display:flex;gap:var(--space-1)">
							<a href="#nav" class="cm-header__link" aria-current="page">notes</a>
							<a href="#nav" class="cm-header__link">about</a>
						</span>
						<span class="cm-spec__val"><code>aria-current="page"</code></span>
					</div>
					<div class="cm-spec__row">
						<span class="cm-spec__label"><code>spy</code></span>
						<span class="cm-spec__sample" style="display:flex;gap:var(--space-1)">
							<a href="#nav" class="cm-header__link is-active">notes</a>
							<a href="#nav" class="cm-header__link">about</a>
						</span>
						<span class="cm-spec__val"><code>is-active · runtime</code></span>
					</div>
				</div>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">HeaderLink</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					Path matching is the part of a nav every consumer gets wrong, so the library
					owns it. The first link points at this page, so it marks itself current; the
					others do not. Note the trailing slashes and the query string, which it
					ignores.
				</p>
				<!-- `cm-spec` wrappers, NOT .cm-header__link. The demo links use the real
				     class so the current state is visible, which means the live scroll-spy
				     can also see them: a bare .cm-header__link with href="#nav" was lit
				     is-active by the header's own spy, so a demo of one state lit the
				     other. Scoping them here keeps the specimen honest. -->
				<div class="cm-spec" role="list">
					<div class="cm-spec__row" role="listitem">
						<span class="cm-spec__label"><code>here</code></span>
						<span class="cm-spec__sample"><HeaderLink href="#nav">#nav</HeaderLink></span>
						<span class="cm-spec__val"><code>aria-current="page"</code></span>
					</div>
					<div class="cm-spec__row" role="listitem">
						<span class="cm-spec__label"><code>other</code></span>
						<span class="cm-spec__sample"><HeaderLink href="/somewhere-else/">/other/</HeaderLink></span>
						<span class="cm-spec__val"><code>no attribute</code></span>
					</div>
					<div class="cm-spec__row" role="listitem">
						<span class="cm-spec__label"><code>external</code></span>
						<span class="cm-spec__sample"><HeaderLink href="https://example.com/">https://…</HeaderLink></span>
						<span class="cm-spec__val"><code>never current</code></span>
					</div>
				</div>
				</section>

			<section id="lists" class="cm-section cm-section--pad" style="margin-bottom:1.8rem">
				<h2>lists / rows</h2>
				<div class="cm-list-head" style="margin-bottom:0.4rem">Index / compact</div>
				<ul class="cm-rows cm-rows--inline">
					<PostRow href="#1" index={3} title="Extract components from a design" description="separate tokens, base, components and runtime." date={new Date('2025-09-26')} />
					<PostRow href="#2" index={2} title="Make them portable" description="zero deps, plain classes, works in any framework." date={new Date('2025-09-25')} />
					<PostRow href="#3" index={1} title="Ship as a library" description="dark default, FOUC-safe theme toggle." date={new Date('2025-09-24')} />
				</ul>
				<div class="cm-list-more"><a href="#">$ cat all →</a></div>
			</section>

			<section id="forms" class="cm-section cm-section--pad" style="margin-bottom:1.8rem">
				<h2>forms</h2>
				<p class="cm-head__sub">
					inputs are element defaults, so a bare <code>&lt;input&gt;</code> is already
					on-brand. <code>.cm-field</code> and friends are the layout around them.
				</p>
				<form class="cm-form" onsubmit="return false">
					<div class="cm-field-row">
						<div class="cm-field">
							<label class="cm-field__label" for="f-name">handle <span class="cm-field__req">*</span></label>
							<input id="f-name" type="text" placeholder="omiinaya" required />
							<span class="cm-field__help">lowercase, no spaces.</span>
						</div>
						<div class="cm-field">
							<label class="cm-field__label" for="f-kind">kind</label>
							<select id="f-kind">
								<option>site</option>
								<option>repo</option>
								<option>service</option>
							</select>
						</div>
					</div>

					<div class="cm-field">
						<label class="cm-field__label" for="f-url">url <span class="cm-field__req">*</span></label>
						<input id="f-url" type="url" placeholder="https://" aria-invalid="true" />
						<span class="cm-field__error">must include the scheme.</span>
					</div>

					<div class="cm-field">
						<label class="cm-field__label" for="f-notes">notes</label>
						<textarea id="f-notes" rows="3" placeholder="what is it for?"></textarea>
					</div>

					<fieldset class="cm-field">
						<legend>visibility</legend>
						<label><input type="checkbox" checked /> listed in nav</label>
						<label><input type="checkbox" /> pinned</label>
					</fieldset>

					<fieldset class="cm-field">
						<legend>access</legend>
						<label><input type="radio" name="f-access" checked /> public</label>
						<label><input type="radio" name="f-access" /> unlisted</label>
					</fieldset>

					<div class="cm-form__actions">
						<button type="reset" class="cm-btn">cancel</button>
						<button type="submit" class="cm-btn cm-btn--primary">save</button>
					</div>
				</form>
			</section>

			<!-- ==================================================== states
			     Every async surface has to render these three, and a system
			     that does not own them lets every consumer invent them —
			     usually in colour, or as an unguarded spinner. -->
			<section id="states" class="cm-section cm-section--pad" style="margin-bottom:var(--space-7)">
				<h2>states</h2>
				<p class="cm-head__sub">
					What a surface shows before it has data, and after it fails. Status is
					carried by a glyph and a word, never by hue: this system has no chroma to
					carry it, and greyscale print still reads correctly.
				</p>

				<h3 class="cm-kicker">empty</h3>
				<div class="cm-state">
					<span class="cm-state__mark" aria-hidden="true">Ø</span>
					<p class="cm-state__title">Nothing here yet</p>
					<p class="cm-state__body">
						An empty surface still needs a shape. A blank div reads as a broken
						page; this one says the same thing on purpose.
					</p>
					<div class="cm-state__actions">
						<a class="cm-btn cm-btn--sm" href="#states">create the first one</a>
					</div>
				</div>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">loading</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					Two different jobs. A <strong>skeleton</strong> is for a surface whose
					shape you already know; a <strong>spinner</strong> is for an action in
					flight. Both stop under <code>prefers-reduced-motion</code>.
				</p>
				<div class="cm-skeleton" aria-hidden="true" style="max-width:22rem">
					<div class="cm-skeleton__block"></div>
					<div class="cm-skeleton__line"></div>
					<div class="cm-skeleton__line cm-skeleton__line--w60"></div>
					<div class="cm-skeleton__line cm-skeleton__line--w40"></div>
				</div>
				<p class="cm-spinner-row" role="status" style="margin-top:var(--space-4)">
					<span class="cm-spinner" aria-hidden="true"></span>
					working…
				</p>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">alerts</h3>
				<div style="display:grid;gap:var(--space-3);max-width:34rem">
					<div class="cm-alert cm-alert--ok" role="status">
						<span class="cm-alert__mark" aria-hidden="true"></span>
						<div class="cm-alert__body">
							<p class="cm-alert__title">saved</p>
							<p class="cm-alert__text">The runtime is bundled and the toggle persists under this site's own key.</p>
						</div>
					</div>
					<div class="cm-alert cm-alert--warn" role="status">
						<span class="cm-alert__mark" aria-hidden="true"></span>
						<div class="cm-alert__body">
							<p class="cm-alert__title">vendored copy is stale</p>
							<p class="cm-alert__text">A consumer still holds an old copy of the layers. Run the sync check before trusting its CSS.</p>
						</div>
					</div>
					<div class="cm-alert cm-alert--err" role="alert">
						<span class="cm-alert__mark" aria-hidden="true"></span>
						<div class="cm-alert__body">
							<p class="cm-alert__title">build failed</p>
							<p class="cm-alert__text">Two of eleven spacing bars measured the wrong length. A specimen that lies is worse than no specimen.</p>
						</div>
					</div>
				</div>

				<h3 class="cm-kicker cm-kicker--plain" style="margin-top:var(--space-6)">table</h3>
				<p class="cm-head__sub" style="margin-bottom:var(--space-3)">
					Data, not prose. The scroll wrapper is part of the component: a wide table
					that overflows the page is the most common way a mono layout breaks on a
					phone, so the component refuses to let it.
				</p>
				<div class="cm-table-wrap" tabindex="0" role="region" aria-label="token cost by layer">
					<table class="cm-table">
						<thead>
							<tr><th>layer</th><th>file</th><th class="num">lines</th><th class="num">touches</th></tr>
						</thead>
						<tbody>
							<tr aria-selected="true"><td>tokens</td><td>tokens.css</td><td class="num">231</td><td class="num">4</td></tr>
							<tr><td>base</td><td>base.css</td><td class="num">412</td><td class="num">7</td></tr>
							<tr><td>components</td><td>components.css</td><td class="num">1180</td><td class="num">31</td></tr>
							<tr><td>runtime</td><td>cli-mono.js</td><td class="num">196</td><td class="num">3</td></tr>
						</tbody>
					</table>
				</div>
			</section>

			<section id="prose" class="cm-section cm-section--pad" style="margin-bottom:1.8rem">
				<h2>prose</h2>
				<div class="cm-prose">
					<h2>A heading</h2>
					<p>oem-ui is the design language: sharp, flat, mono, high-contrast, dark by default. Transitions are <code>0.12s</code>, corners stay square, and borders do the lifting.</p>
					<blockquote>Only touch a line if you can explain why it moved. The layout must be stable between scrolling and non-scrolling pages.</blockquote>
					<pre><code>{`:root { --maxw: 860px; --gutter: 1.25rem; }`}</code></pre>
				</div>
			</section>

			<section id="readme" class="cm-section cm-section--pad">
				<h2>usage</h2>
				<div class="cm-term">
					<div class="cm-term__bar">
						<span class="cm-term__dot"></span><span class="cm-term__dot"></span><span class="cm-term__dot"></span>
						<span class="cm-term__title">README</span>
					</div>
					<div class="cm-term__body">
						<pre># oem-ui
npm i -D oem-ui@workspace or copy src/ into your project.
Include tokens.css, base.css, components.css and cli-mono.js.
Astro: import Header/Footer/Head/PageHead/PostHead from 'oem-ui/astro'.</pre>
					</div>
				</div>
			</section>
		</main>
		<Footer
			items={['astro', 'static', 'zero deps']}
			contactHref="mailto:omar@mrxlab.net"
			status="all systems nominal — sig: static only"
		/>

	<!-- Runtime. Use a real script tag: a frontmatter import of a
	     side-effect-only file gets tree-shaken out of the bundle. -->
	<!-- Imported, not a raw <script src>: a relative src on a .astro page is
     NOT treated as a build asset, so Astro emitted the tag verbatim and no
     JS ever shipped. Importing it hands the file to Vite, which bundles it
     and rewrites the src to a hashed asset. -->
<script>
	import '../js/cli-mono.js';
</script>
	</body>
	</html>
