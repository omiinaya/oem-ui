---
/**
 * oem-ui <Head> — meta, fonts, theme-color, FOUC guard.
 * Copy-paste. Import your own global stylesheet where noted.
 */
import { SITE } from './config';

interface Props {
	title: string;
	description?: string;
	/** path to your global.css, relative to this component */
	stylesHref?: string;
}

const { title, description = SITE.description, stylesHref } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');
const fullTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
---

<!--
	FOUC guard. MUST be the FIRST node in <head>, before even the charset
	declaration and before any stylesheet, or a light-theme visitor sees a
	dark flash. Keep it inline.
-->
<script is:inline>
	(function () {
		try {
			var s = localStorage.getItem('cm-theme');
			if (s === 'light') document.documentElement.setAttribute('data-theme', 'light');
		} catch (e) {}
	})();
</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- theme-color must match tokens.css: #0a0a0a dark / #fafafa light -->
<meta name="theme-color" content="#0a0a0a" />

<!-- canonical -->
<link rel="canonical" href={canonicalURL} />
<title>{fullTitle}</title>
<meta name="description" content={description} />

<!-- open graph / twitter -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta name="twitter:card" content="summary" />

{stylesHref && <link rel="stylesheet" href={stylesHref} />}
