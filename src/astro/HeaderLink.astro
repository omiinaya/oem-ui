---
/**
 * oem-ui <HeaderLink> — one nav link that knows whether it is the page you
 * are on, and marks itself `aria-current="page"` when it is.
 *
 * Why this is a component and not three lines of `Astro.url` in every page:
 * path matching is the part of a nav that every consumer gets subtly wrong.
 * The mistakes are specific, and each one is invisible until a reader is on
 * the second page of the site:
 *
 *   - `/blog/` and `/blog` are the same page. Comparing raw strings leaves
 *     the link dark on the blog index, which is the page the reader is on.
 *   - a site served under a `base` prefix (`/dev-blog/`) has URLs the naive
 *     comparison never matches, so NO link is ever current.
 *   - query strings and hashes are not part of a page's identity.
 *   - a link to `/` must match only the root, not every path by prefix.
 *
 * Pass `href` and a slot. The component decides ONLY the `aria-current`
 * attribute; the appearance belongs to the library's
 * `.cm-header__link[aria-current='page']` rule, which is why there is no
 * <style> block here. A second rule for the same state in a second layer is
 * a cascade race, and it is how a nav ends up looking different from the
 * one the library documents.
 */
import type { HTMLAttributes } from 'astro/types';
import { isCurrentPage } from './current';

type Props = HTMLAttributes<'a'> & {
	/** Match the first path segment too, so `/blog` stays current on `/blog/a-post`. */
	matchSegment?: boolean;
	/** Escape hatch: decide it yourself. Overrides all matching. */
	active?: boolean;
};

const {
	href = '',
	class: className = 'cm-header__link',
	matchSegment = false,
	active,
	...rest
} = Astro.props;

/* Astro.url is the page being rendered; the href is where the link goes.
   The matcher is SHARED with <Header>, so a nav that renders one component
   and a nav that renders the other cannot disagree about which link is
   current. `import.meta.env?.BASE_URL` is optional-chained because this file
   is also read by the contract tests, outside a build. */
const base = (import.meta.env?.BASE_URL ?? '/').replace(/\/$/, '');

const isActive =
	active !== undefined
		? active
		: isCurrentPage(String(href), Astro.url.pathname, base, matchSegment);
---

<a
	href={href}
	class={className}
	aria-current={isActive ? 'page' : undefined}
	{...rest}
>
	<slot />
</a>
