---
/**
 * oem-ui <TimelineItem> — one dated record inside a .cm-timeline list.
 *
 * Renders the rail and the dot itself, so a consumer only has to own
 * the <ul> and the ordering. `now` fills the dot, which is how the
 * current role is marked without a second colour.
 */
interface Props {
	/** When the record applies: "2014 – 2017", "Feb 2022 – present". */
	period: string;
	role: string;
	org: string;
	/** Optional second org line: location, employment type. */
	meta?: string;
	/**
	 * Optional prose under the heading. A newline-delimited string is
	 * split into paragraphs; an ARRAY is rendered as one paragraph per
	 * item. The array form exists because that is how a data file wants
	 * to hold it — a caller storing records in a .ts file should not have
	 * to join and re-split the same list to get paragraphs.
	 */
	body?: string | string[];
	/** Marks the record the person is in now. Fills the dot. */
	now?: boolean;
}

const { period, role, org, meta, body, now = false } = Astro.props;

// One source, two accepted shapes. Normalised here so the template only
// ever sees a list, and so an empty string and an empty array both render
// no body rather than one blank paragraph.
const paras = Array.isArray(body)
	? body.filter((p) => p.trim())
	: typeof body === 'string'
		? body.split('\n').filter((l) => l.trim())
		: [];
---

<li class="cm-timeline__item" class:list={{ 'cm-timeline__item--now': now }}>
	<span class="cm-timeline__period">{period}</span>
	<span class="cm-timeline__role">{role}</span>
	<span class="cm-timeline__org">{org}</span>
	{meta && <span class="cm-timeline__meta">{meta}</span>}
	{
		paras.length > 0 && (
			<div class="cm-timeline__body">
				{paras.map((line) => (
					<p>{line}</p>
				))}
			</div>
		)
	}
</li>
